// ---------------- YARDIMCILAR ----------------
// millis() 49 günde bir başa sarar: "zamanı geldi mi" hep bu farkla sorulur (0 = hemen)
static inline bool reached(uint32_t now, uint32_t t) { return t == 0 || (int32_t)(now - t) >= 0; }
static inline float clampf(float v, float a, float b) { return v < a ? a : (v > b ? b : v); }
static inline float lerpf(float a, float b, float t) { return a + (b - a) * t; }
static inline float frand(float a, float b) { return a + (b - a) * (random(10001) / 10000.0f); }
static inline uint16_t rgb(float r, float g, float b) {
  return lcd.color565((uint8_t)clampf(r, 0, 255), (uint8_t)clampf(g, 0, 255), (uint8_t)clampf(b, 0, 255));
}


