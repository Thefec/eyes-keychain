// ---------------- TÜRLER (fonksiyonlardan önce olmalı) ----------------
// Kritik sönümlü yay: hedefe yaylanarak, kare hızından bağımsız gider
struct Spring {
  float x = 0, v = 0, t = 0;
  void step(float dt, float k) {
    float c = 2.0f * sqrtf(k);
    v += (k * (t - x) - c * v) * dt;
    x += v * dt;
  }
  bool moving() const { return fabsf(v) > 0.02f || fabsf(t - x) > 0.01f; }
};

// Göz şekli parametreleri
enum { S_W, S_H, S_R, S_GAP, S_TIRED, S_ANGRY, S_SAD, S_HAPPY, S_BOTTOM, S_SIZE_L, S_SIZE_R, S_LOOKY, S_COUNT };

struct ModePreset {
  const char *name;
  uint8_t r, g, b;
  float shape[S_COUNT];
  uint16_t blinkMin, blinkMax;     // ms
  float blinkSpeed;                // 1 = normal, >1 = yavaş
  uint16_t lookMin, lookMax;       // ms
  float lookRange;
  float bobAmp;                    // px
  uint8_t idleW[7];                // boş davranış ağırlıkları
};

// Boş davranışlar (kişilik)
enum Idle { I_NONE, I_CURIOUS, I_SLEEPY, I_HAPPY, I_SURPRISE, I_WINK, I_LOOKAROUND,
            I_ROLL, I_UPDOWN, I_THINK, I_DIZZY, I_YAWN, I_SQUINT, I_LOVE, I_SHIVER, I_BOUNCE, I_COUNT };
const int IDLE_EXTRA = I_COUNT - I_LOOKAROUND - 1;     // yeni hareket sayısı (9)

// Telefondan gelen geçici duygular
enum Emotion { E_NONE, E_HAPPY, E_ANGRY, E_SAD, E_SURPRISED, E_SLEEPY, E_LOVE, E_CONFUSED, E_WINK, E_COUNT };

struct TextLine { char buf[161]; int width = 0; uint32_t until = 0; float x = 0; bool active = false; };

enum PType { P_NOTE, P_ZZZ, P_TEAR, P_HEART, P_SPARK };

struct Particle { bool on; uint8_t type; float x, y, vx, vy, life, maxLife; uint8_t r, g, b; };

struct Cmd { uint8_t len; uint8_t data[200]; };

